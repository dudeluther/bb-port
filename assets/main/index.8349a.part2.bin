EndlessModeScreenClearShield: [ {
id: 338070003,
param: {
historyHighScoreFloor: 1e4,
logicDesc: "保护窗口 5 回合，窗口内替换第一个命中出块id为12009 12008 26002 5400012 12021 12024 12001 12013 12040 291054的算法，每次清屏最多替换 1 个。只拉长观察窗口而不放宽替换次数，用来区分“窗口长度”与“替换次数”两个因素的独立影响。触发门槛为清屏时分数低于基准分的 0.7 倍（触发分数比例），基准分取历史最高分，历史最高分低于 10000 或无历史最高分时按 10000 计。",
maxReplaceCount: 1,
replacementPool: 0,
triggerScoreRatio: .7,
windowRounds: 5
}
}, {
id: 338070002,
param: {
historyHighScoreFloor: 1e4,
logicDesc: "保护窗口 5 回合，窗口内替换前两个命中出块id为12009 12008 26002 5400012 12021 12024 12001 12013 12040 291054的算法，每次清屏最多替换 2 个。把缓冲期从清屏后 3 轮拉长到 5 轮，并允许两次替换，进一步压低清屏后短时间内连续熵增的概率。触发门槛为清屏时分数低于基准分的 0.7 倍（触发分数比例），基准分取历史最高分，历史最高分低于 10000 或无历史最高分时按 10000 计。",
maxReplaceCount: 2,
replacementPool: 0,
triggerScoreRatio: .7,
windowRounds: 5
}
}, {
id: 338070001,
param: {
historyHighScoreFloor: 1e4,
logicDesc: "保护窗口 3 回合，窗口内替换第一个命中出块id为12009 12008 26002 5400012 12021 12024 12001 12013 12040 291054的算法，每次清屏最多替换 1 个。以清屏为起点开启短窗口，只对偏难的熵增出块做一次定向替换，让清屏后的正反馈延续，同时把难度曲线的扰动压到最小。触发门槛为清屏时分数低于基准分的 0.7 倍（触发分数比例），基准分取历史最高分，历史最高分低于 10000 或无历史最高分时按 10000 计。",
maxReplaceCount: 1,
replacementPool: 0,
triggerScoreRatio: .7,
windowRounds: 3
}
} ],
