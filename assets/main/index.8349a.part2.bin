EndlessRecordBreakEffect: [ {
id: 337308001,
param: {
logicDesc: "预期效果：仅当本局分数大于历史最高分的 0.5 倍（最高分 50%）时，才判定为“破纪录/大突破”并播放欢呼音效+庆祝动画；本局分数 ≤ 历史最高分 × 0.5 一律走“未超过阈值”表现，播放情绪平缓、不沮丧的音效，配一套幅度更小、更克制的结算动效，不触发庆祝动画。 对比意图：将破纪录的门槛从主方案默认的“严格大于历史最高分”降低至“历史最高分×0.5”。"
}
}, {
