G18_FNewElementGuide: [ {
id: 334652001,
param: {
G18_FNewElementGuide_ElementGuideCfg: {
entries: [ {
elementType: "balloon",
handTarget: {
col: 3,
other: 1,
row: 5
},
highlightTargets: [ {
col: 2,
other: 1,
row: 5
}, {
col: 3,
other: 1,
row: 5
}, {
col: 4,
other: 1,
row: 5
} ],
level: 1,
tipText: "<color=#1a2e6b>Tap two or more cubes of the same color to collect the <color=#9333ea><b>CAKES</b></color>!</color>"
}, {
elementType: "wooden_box",
level: 4,
tipText: "<color=#1a2e6b>Tap cubes next to a <color=#9333ea><b>CRATE</b></color> to destroy it!</color>"
}, {
elementType: "bubble",
level: 11,
tipText: "<color=#1a2e6b>Tap cubes next in a <color=#9333ea><b>BUBBLE</b></color> to destroy it!</color>"
}, {
elementType: "magic_hat",
level: 21,
tipText: "<color=#1a2e6b>Tap cubes next to the <color=#9333ea><b>MAGIC BAG</b></color> to summon birds!</color>"
}, {
elementType: "balloon",
level: 31,
tipText: "<color=#1a2e6b>Tap cubes that match the balloon's color next to the <color=#9333ea><b>BALLOONS</b></color> to collect them!</color>"
}, {
elementType: "duck",
level: 41,
tipText: "<color=#1a2e6b>Clear the cubes beneath the <color=#9333ea><b>BEAR</b></color> so it falls to the bottom row to collect it!</color>"
}, {
elementType: "cola_bottle",
level: 51,
tipText: "<color=#1a2e6b>Tap cubes next to the <color=#9333ea><b>TV</b></color> twice to collect it!</color>"
}, {
elementType: "shelf",
level: 61,
tipText: "<color=#1a2e6b>Tap cubes  next to the <color=#9333ea><b>shelf</b></color> multiple times to collect the items!</color>"
}, {
elementType: "wooden_box",
level: 71,
tipText: "<color=#1a2e6b>Tap cubes that match the <color=#9333ea><b>Wooden boxes</b></color> color next to the <color=#9333ea><b>Wooden boxes</b></color> to collect them!</color>"
}, {
elementType: "color_balloon",
level: 81,
tipText: "<color=#1a2e6b>Tap cubes of different colors next to the <color=#9333ea><b>balloon target</b></color> to complete the goal!</color>"
}, {
elementType: "grass",
level: 201,
tipText: "<color=#1a2e6b>Tap cubes next to the <color=#9333ea><b>GRASS</b></color> to remove it!</color>"
}, {
elementType: "stone_statue",
level: 281,
tipText: "<color=#1a2e6b>The <color=#9333ea><b>STATUE</b></color> can only be cleared by using boosters—be sure to blast it!</color>"
} ]
},
atomFeatureName: "G18_FNewElementGuide",
version: 1,
worldId: "G18_FBase_World"
}
