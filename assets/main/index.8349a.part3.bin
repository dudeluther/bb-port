ScoreExpectTierStrategy: [ {
editer_time: 1793276429,
id: 338073001,
param: {
logicDesc: "只对 GP 新增用户在无尽模式生效，作用位置是每次出题的后置替换环节。玩家历史最高分低于 7000 时，一旦在局内突破自己的历史最高分，从下一轮开始连续 2 轮出极其困难难题；当轮已出的三块不改动。历史最高分达到 7000 后，阶段一永久停止。阶段二从最高分达到 7000 时启用：写入标记分数等于当时玩家分数，此后跨局保持不变，即使玩家刷新历史最高分也不更新；本局分数达到标记分数的 1.3 倍时触发一次 2 轮极其困难难题，触发完成后才把标记分数重置为触发时刻的分数。已在极其困难窗口内时，新的破纪录或标记分数达成不生效、不延长窗口，按原窗口走完 2 轮。"
},
param_type: {
logicDesc: "String"
}
} ],
