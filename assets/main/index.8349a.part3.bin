}
} ],
TravelFailBannerHide_1: [ {
id: 336151001,
param: {
logicDesc: "预期效果：更晚触发 banner 隐藏，减少广告曝光损失。\n对比意图：与主方案阈值=2 对比，验证更保守的隐藏阈值对留存与广告收益的影响。"
}
} ],
TravelFailBannerHide_2: [ {
id: 336152001,
param: {
logicDesc: "预期效果：全程仅隐藏一次，控制广告曝光损失。\n对比意图：与主方案重复触发开启对比，验证重复隐藏是否比单次隐藏更能提升连续失败玩家的留存。"
}
} ],
TravelFailBannerHide_3: [ {
id: 336153001,
param: {
logicDesc: "预期效果：隐藏持续 2 关，给失败玩家更长的恢复窗口。\n对比意图：与主方案生效 1 关对比，验证更长隐藏时长对留存与广告收益的影响。"
}
} ],
TravelFailBannerHide_4: [ {
id: 336154001,
param: {
logicDesc: "预期效果：仅死亡计失败，步数耗尽不计，隐藏触发更严格。\n对比意图：与主方案死亡+步数耗尽均计对比，验证失败判定范围对隐藏频率与体验的影响。"
}
} ],
